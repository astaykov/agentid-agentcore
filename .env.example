# AWS settings
AWS_PROFILE=agentid-poc
AWS_REGION=eu-central-1
STACK_NAME=agentid-poc

# AgentCore runtime
RUNTIME_NAME_PREFIX=agentid_core
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
PYTHON_RUNTIME=PYTHON_3_12

# S3 artifact
# ARTIFACT_BUCKET=   # auto-generated if blank
ARTIFACT_KEY=agent-runtime.zip

# Build settings (ARM64 cross-compilation via Docker)
ZIP_PATH=build/agent-runtime.zip
DOCKER_PLATFORM=linux/amd64
TARGET_PLATFORM=manylinux2014_aarch64
TARGET_PYTHON_VERSION=3.12
TARGET_ABI=cp312

# Entra Identity (fill in your values)
ENTRA_TENANT_ID=<your-tenant-id>
AGENT_IDENTITY_ID=<your-agent-identity-object-id>
# Secret JSON format: {"clientId":"...","clientSecret":"..."}
BLUEPRINT_SECRET_ARN=<arn:aws:secretsmanager:region:account:secret:name>

# AgentCore Inbound Identity — Entra JWT authorizer
# AGENTCORE_APP_CLIENT_ID: the Blueprint app registration client ID
#   (this is the 'aud' claim in the token the SPA requests)
AGENTCORE_APP_CLIENT_ID=<your-blueprint-app-registration-client-id>

# Echo API (deployed as Lambda + API Gateway by CloudFormation — no URL needed as input)
# ECHO_API_URL is computed from the stack and injected automatically.
ECHO_API_SCOPE=api://echo-api/access_as_user
# ECHO_API_CLIENT_ID: the Entra app registration client ID for the Echo API.
#   Used as the JWT audience in the API Gateway authorizer.
ECHO_API_CLIENT_ID=<your-echo-api-app-registration-client-id>

# MCP Server
MCP_SERVER_URL=https://mcp.svc.cloud.microsoft/enterprise
MCP_SERVER_SCOPE=MCP.User.Read.All MCP.GroupMember.Read.All
